# Copy to .env and fill in. .env is git-ignored: never commit real values.
# Generate a password with:  python -c "import secrets; print(secrets.token_urlsafe(24))"
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=geoagent
DB_USER=
DB_PASSWORD=

BLOB_STORE=local
BLOB_ROOT=blobdata
BLOB_BUCKET=geoagent-raw

LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://127.0.0.1:11434

# AI Studio key, used for embeddings locally (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
EMBEDDING_BATCH_SIZE=32

TOP_K=8
MIN_SIMILARITY=0.5
LOG_LEVEL=INFO
