# Copy to .env and fill in. .env is git-ignored.
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@localhost:5432/geoagent

BLOB_STORE=local
BLOB_ROOT=blobdata
BLOB_BUCKET=geoagent-raw

LLM_PROVIDER=ollama
LLM_MODEL=qwen3:14b
OLLAMA_BASE_URL=http://gpu-host.lan:11434

# AI Studio key, used for embeddings locally (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
EMBEDDING_BATCH_SIZE=32

TOP_K=8
MIN_SIMILARITY=0.5
LOG_LEVEL=INFO
